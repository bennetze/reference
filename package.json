{
  "name": "",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.18.0"
  },
  "scripts": {
    "predev": "npm run build && npm run deploy",
    "dev": "astro dev",
    "dev:local": "astro dev",
    "build": "npm run crawlers:check && astro build && node scripts/prepare-crawler-files.mjs production && node scripts/verify-site-build.mjs production && node scripts/audit-accessibility.mjs",
    "build:pages": "npm run crawlers:check && DEPLOY_TARGET=github-pages astro build && node scripts/prune-pages-motion-fallbacks.mjs && node scripts/prepare-crawler-files.mjs github-pages && node scripts/verify-pages-artifact.mjs && node scripts/verify-site-build.mjs github-pages && node scripts/audit-accessibility.mjs",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages -d dist -b gh-pages -r https://github.com/bennetze/reference.git --nojekyll -m \"Deploy website\"",
    "preview": "astro preview",
    "preview:pages": "DEPLOY_TARGET=github-pages astro preview",
    "astro": "astro",
    "encode-video": "scripts/encode-site-video.sh",
    "crawlers:check": "node scripts/sync-crawler-files.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/test-site-browser.mjs",
    "security:check": "npm audit --include=dev --include=optional --include=peer && npm audit signatures",
    "test:site": "npm test",
    "audit:accessibility": "node scripts/audit-accessibility.mjs",
    "preview:accessibility": "node scripts/preview-accessibility.mjs",
    "audit:performance": "node scripts/audit-performance.mjs",
    "crawlers:sync": "node scripts/sync-crawler-files.mjs"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "gh-pages": "6.1.1",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "private": true,
  "packageManager": "npm@11.18.0"
}
