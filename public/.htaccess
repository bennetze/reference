ErrorDocument 404 /404.html

# Portable baseline for Apache-compatible hosting. Re-test every directive with
# the final host; providers such as GitHub Pages ignore this file entirely.
<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'self'; frame-src 'none'; img-src 'self' data:; manifest-src 'self'; media-src 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests"
	Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# Text responses benefit from compression; media and WOFF2 are already compressed.
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
	# HTML must revalidate after showcase updates.
	<If "%{REQUEST_URI} =~ m#(?:/|\.html)$#">
		Header set Cache-Control "no-cache"
	</If>
	# Only Astro's content-hashed assets may be cached immutably.
	<If "%{REQUEST_URI} =~ m#^/_astro/[^/]+\.[A-Za-z0-9_-]{8,}(?:_[A-Za-z0-9_-]+)?\.[A-Za-z0-9]+$#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
</IfModule>
