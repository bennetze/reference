---
const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<section class="demo-intro" aria-labelledby="demo-title">
	<div class="demo-intro__copy">
		<h1 id="demo-title">Dies ist eine Website-Demo.</h1>
		<p>Diese Website dient der Präsentation eines Designentwurfs und ist keine offizielle Unternehmenswebsite.</p>
		<a class="demo-intro__enter" href={`${basePath}start/`}>Demo ansehen</a>
	</div>
</section>

<style>
	.demo-intro {
		display: grid;
		place-items: center;
		min-height: 100vh;
		min-height: 100svh;
		padding: 4rem 1.5rem;
		color: #171717;
		background: #ffffff;
		text-align: center;
		scroll-margin-top: 0;
	}
	.demo-intro__copy { width: min(100%, 42rem); }
	h1 {
		margin: 0;
		font-size: clamp(2.25rem, 4.5vw, 4rem);
		font-weight: 450;
		letter-spacing: -0.035em;
		line-height: 1.15;
	}
	p {
		max-width: 34rem;
		margin: 1.5rem auto 2.5rem;
		font-size: clamp(1.125rem, 1.5vw, 1.25rem);
		line-height: 1.6;
		color: #555555;
	}
	.demo-intro__enter {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 60px;
		padding: 1rem 2.5rem;
		color: #ffffff;
		background: #171717;
		border: 1px solid #171717;
		font-size: 1rem;
		font-weight: 450;
		text-decoration: none;
		transition: background 180ms ease;
	}
	.demo-intro__enter:hover { background: #353535; }
	.demo-intro__enter:focus-visible { outline: 2px solid #171717; outline-offset: 6px; }
	@media (prefers-reduced-motion: reduce) {
		.demo-intro__enter { transition: none; }
	}
</style>
