---
import type { ImageMetadata } from 'astro';
import MotionPoster from './MotionPoster.astro';

interface Props {
	mp4: string;
	mobileMp4: string;
	webm: string;
	poster: ImageMetadata;
	avif: string;
	webp: string;
	alt: string;
}
const { mp4, mobileMp4, webm, poster, avif, webp, alt } = Astro.props;
---

<div class="editorial-motion" data-motion-panel>
	<video muted loop playsinline webkit-playsinline preload="none" disablepictureinpicture data-motion-video aria-hidden="true">
		<source data-motion-src={mp4} data-motion-mobile-src={mobileMp4} type="video/mp4" />
		<source data-motion-src={webm} type="video/webm" />
	</video>
	<MotionPoster {poster} {avif} webp={import.meta.env.BASE_URL === '/' ? webp : undefined} {alt} sizes="(max-width: 840px) 76vw, 42vw" />
</div>

<script>
	import '../scripts/homepage.js';
</script>

<style>
	.editorial-motion { position: relative; aspect-ratio: 16 / 9; }
	.editorial-motion video,
	.editorial-motion :global(picture),
	.editorial-motion :global(img) { position: absolute; inset: 0; width: 100%; height: 100% !important; object-fit: cover; }
	.editorial-motion video { visibility: hidden; opacity: 0; transition: opacity 300ms ease; }
	.editorial-motion.is-video-ready video { visibility: visible; opacity: 1; }
	.editorial-motion.is-video-ready :global(picture) { opacity: 0; pointer-events: none; }
	@media (prefers-reduced-motion: reduce) { .editorial-motion video { transition: none; } }
</style>
