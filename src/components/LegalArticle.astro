---
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<main class="legal-page" id="main-content" tabindex="-1">
	<h1>{title}</h1>
</main>

<style>
	.legal-page {
		min-height: 100svh;
		padding: calc(var(--site-header-height, 88px) + clamp(5rem, 10vw, 9rem)) 1.5rem 5rem;
		background: var(--gradient-editorial);
		color: var(--gradient-ink);
		text-align: center;
	}

	h1 {
		margin: 0;
		font-size: clamp(1.25rem, 3.5vw, 3.5rem);
		font-weight: 450;
		letter-spacing: 0.08em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	@media (max-width: 480px) {
		h1 {
			font-size: clamp(1.125rem, 5vw, 1.65rem);
		}
	}
</style>
